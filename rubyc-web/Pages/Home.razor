@code {
    private int selectedBenchmark;
    private record BenchmarkRow(string Label, string Detail, string Display, int Width);
    private record Benchmark(string Name, string Highlight, string Suffix, string Headline, string Description, string Unit, BenchmarkRow[] Rows);
    private readonly Benchmark[] benchmarks = [
        new("Binary size", "4.69", "kB", "A hello that travels light.", "4,688 bytes. A complete, standalone hello-world executable — about 63% smaller than the documented C build.", "BYTES / DECIMAL kB", [new("RubyC", "static native", "4,688 B", 37), new("C", "gcc -O2 · dynamic", "12,568 B", 100), new("C++", "g++ -O2 · dynamic", "12,576 B", 100)]),
        new("Runtime", "226", "µs", "From launch to hello.", "Average wall time for the hello-world process, including spawn. Measured over 200 runs on the development VM.", "MICROSECONDS / 200-RUN AVERAGE", [new("RubyC", "static native", "226 µs", 26), new("C", "gcc -O2 · dynamic", "516 µs", 60), new("C++", "g++ -O2 · dynamic", "861 µs", 100)]),
        new("Compile time", "2", "ms", "A short path from source.", "Reported compile time for this tiny example. Compiler timings depend on workload, machine, and measurement conditions.", "MILLISECONDS / REPORTED SNAPSHOT", [new("RubyC", "native build", "2 ms", 9), new("C", "gcc -O2", "23 ms", 48), new("C++", "g++ -O2", "44 ms", 100)])
    ];
    private bool menuOpen;
    private bool copied;
    private int selectedExample;
    private void CloseMenu() => menuOpen = false;
    private void SelectExample(int index) { selectedExample = index; copied = false; }
    private async Task HandleTabKey(KeyboardEventArgs e)
    {
        int? next = e.Key switch { "ArrowRight" or "ArrowDown" => (selectedExample + 1) % examples.Length, "ArrowLeft" or "ArrowUp" => (selectedExample + examples.Length - 1) % examples.Length, "Home" => 0, "End" => examples.Length - 1, _ => null };
        if (next is int index) { SelectExample(index); await JS.InvokeVoidAsync("rubyc.focusTab", $"tab-{index}"); }
    }
    private async Task CopyCommand() { copied = await JS.InvokeAsync<bool>("rubyc.copy", examples[selectedExample].Command); }
    private record Example(string Title, string File, string Html, string Command, string Output, string Mode);
    private readonly Example[] examples = [
        new("Hello, native.", "hello.rc", "<span class='code-comment'>// A familiar start. A different destination.</span>\n<span class='code-purple'>namespace</span> app;\n\n<span class='code-purple'>class</span> <span class='code-yellow'>hello</span>\n{\n    <span class='code-purple'>int</span> <span class='code-blue'>main</span>()\n    {\n        <span class='code-blue'>printf</span>(<span class='code-green'>\"Hello from RubyC!\"</span>);\n        <span class='code-purple'>return</span> <span class='code-orange'>0</span>;\n    }\n}", "rubyc build hello.rc -o hello", "Standalone native executable → ./hello", "NATIVE BUILD"),
        new("Think in code.", "calculate.rc", "<span class='code-comment'>// Your logic, one step closer to the machine.</span>\n<span class='code-purple'>namespace</span> app;\n\n<span class='code-purple'>class</span> <span class='code-yellow'>calculate</span>\n{\n    <span class='code-purple'>int</span> <span class='code-blue'>main</span>()\n    {\n        <span class='code-purple'>int</span> answer = <span class='code-orange'>6</span> * <span class='code-orange'>7</span>;\n        <span class='code-blue'>printf</span>(<span class='code-green'>\"{0}\"</span>, answer);\n        <span class='code-purple'>return</span> <span class='code-orange'>0</span>;\n    }\n}", "rubyc run calculate.rc", "Expected output → 42", "JIT EXECUTION"),
        new("Build your way.", "build.sh", "<span class='code-comment'># One source. Different ways to build.</span>\n\n<span class='code-comment'># A standalone native executable</span>\n<span class='code-blue'>rubyc</span> build hello.rc -o hello\n\n<span class='code-comment'># A shared library</span>\n<span class='code-blue'>rubyc</span> build -O shared -o libhello.so hello.rc\n\n<span class='code-comment'># Choose an installed target explicitly</span>\n<span class='code-blue'>rubyc</span> build hello.rc \\\n    --target <span class='code-green'>linux_x86_64</span> -o hello", "rubyc list --kind target", "Discover your installed target backends", "TARGET DISCOVERY")
    ];
}
